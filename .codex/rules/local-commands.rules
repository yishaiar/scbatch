# Migration of the allowed commands from .claude-yishaiar/settings.local.json.
# Rules only apply when a command must run outside the workspace sandbox.

# Test, lint, formatting, type-check, and repository code commands.
prefix_rule(pattern = ["pytest"], decision = "allow")
prefix_rule(pattern = ["ruff"], decision = "allow")
prefix_rule(pattern = ["basedpyright"], decision = "allow")
prefix_rule(pattern = ["python"], decision = "allow")
prefix_rule(pattern = ["python3"], decision = "allow")
prefix_rule(pattern = [".venv/bin/python"], decision = "allow")

prefix_rule(pattern = ["git", "rev-parse"], decision = "allow")
prefix_rule(pattern = ["git", "status"], decision = "allow")
prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "log"], decision = "allow")
prefix_rule(pattern = ["git", "branch"], decision = "allow")
prefix_rule(pattern = ["git", "tag"], decision = "allow")

prefix_rule(pattern = ["uv", "run", "pytest"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "ruff"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "basedpyright"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "python"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "python3"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "ruff", "check"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "ruff", "format"], decision = "allow")
prefix_rule(pattern = ["nohup", "uv", "run", "jupyter", "lab"], decision = "allow")

# Start Jupyter or execute notebooks through nbconvert.
prefix_rule(pattern = ["jupyter", "lab"], decision = "allow")
prefix_rule(pattern = ["jupyter", "notebook"], decision = "allow")
prefix_rule(pattern = ["jupyter", "nbconvert"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "jupyter", "lab"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "jupyter", "notebook"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "jupyter", "nbconvert"], decision = "allow")
prefix_rule(pattern = [".venv/bin/jupyter", "lab"], decision = "allow")
prefix_rule(pattern = [".venv/bin/jupyter", "notebook"], decision = "allow")
prefix_rule(pattern = [".venv/bin/jupyter", "nbconvert"], decision = "allow")

# Read-only Jupyter kernel and server diagnostics.
prefix_rule(pattern = ["jupyter", "kernelspec", "list"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "jupyter", "kernelspec", "list"], decision = "allow")
prefix_rule(pattern = ["/Users/yishai/Desktop/build_pip_package/scbatch/.venv/bin/jupyter", "kernelspec", "list"], decision = "allow")
prefix_rule(pattern = ["sed", "-n", "1,260p", "/tmp/jupyterlab-codex.log"], decision = "allow")
prefix_rule(pattern = ["ps", "-axo", "pid=,command="], decision = "allow")
prefix_rule(pattern = ["ps", "-ax", "-o", "pid=,ppid=,stat=,command="], decision = "allow")
prefix_rule(pattern = ["rg", "[j]upyter-lab.*8889"], decision = "allow")
prefix_rule(pattern = ["launchctl", "list"], decision = "allow")
prefix_rule(pattern = ["launchctl", "submit"], decision = "allow")
prefix_rule(pattern = ["launchctl", "remove"], decision = "allow")
prefix_rule(pattern = ["tail", "-120", "/tmp/jupyterlab-scbatch-worktree.log"], decision = "allow")
prefix_rule(pattern = ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}\\n", "http://127.0.0.1:8888/api/status"], decision = "allow")
prefix_rule(pattern = ["curl", "--retry", "5", "--retry-connrefused", "--retry-delay", "1", "-s", "-o", "/dev/null", "-w", "%{http_code}\\n", "http://127.0.0.1:8889/api/status"], decision = "allow")

prefix_rule(pattern = ["ls"], decision = "allow")
prefix_rule(pattern = ["find"], decision = "allow")
prefix_rule(pattern = ["grep"], decision = "allow")
prefix_rule(pattern = ["test"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", ["view", "list"]], decision = "allow")
prefix_rule(pattern = ["gh", "repo", "view"], decision = "allow")

# Auto-allowed commands used by the commit and create-PR workflows. Push and
# merge remain intentionally unallowed because those steps require explicit user direction.
prefix_rule(pattern = ["git", "add"], decision = "allow")
prefix_rule(pattern = ["git", "commit"], decision = "allow")
prefix_rule(pattern = ["git", "fetch"], decision = "allow")
prefix_rule(pattern = ["git", "rebase"], decision = "allow")
prefix_rule(pattern = ["uv", "sync"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", ["create", "edit"]], decision = "allow")


# Commands that change repository, environment, remote, or arbitrary code state
# still require an approval.
prefix_rule(pattern = ["mkdir"], decision = "prompt")
prefix_rule(pattern = ["docker-compose"], decision = "prompt")
prefix_rule(pattern = ["uv", "pip"], decision = "prompt")
